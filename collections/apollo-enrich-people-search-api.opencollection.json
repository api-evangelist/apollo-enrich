{
  "opencollection": "1.0.0",
  "info": {
    "name": "Apollo.io Accounts People Search API",
    "version": "1.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "x-api-key",
      "value": "{{x-api-key}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "People Search",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Search for people",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.apollo.io/api/v1/mixed_people/api_search",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Searches Apollo's people database for prospects. Requires a master API key. Does not return email addresses or phone numbers - pair with People Enrichment to reveal contact details. Paginates up to 50,000 records (100 per page, up to 500 pages)."
        }
      ]
    }
  ],
  "bundled": true
}