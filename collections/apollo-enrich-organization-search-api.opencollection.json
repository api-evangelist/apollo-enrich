{
  "opencollection": "1.0.0",
  "info": {
    "name": "Apollo.io Accounts Organization Search API",
    "version": "1.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "x-api-key",
      "value": "{{x-api-key}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Organization Search",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Search for organizations",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.apollo.io/api/v1/mixed_companies/search",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Searches Apollo's company database. Consumes Apollo credits per page when data is returned. Paginates up to 50,000 records (100 per page, up to 500 pages)."
        }
      ]
    }
  ],
  "bundled": true
}